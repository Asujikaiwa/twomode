# Local development values. Copy to .dev.vars (which wrangler reads) and never
# commit that file. Production secrets are set with `wrangler secret put NAME`.
#
#   cp .env.example .dev.vars

# Public base URL used for canonical links, hreflang and the sitemap.
APP_URL="http://localhost:5173"
ENVIRONMENT="development"

# Session signing secret for better-auth.
#   openssl rand -base64 32
BETTER_AUTH_SECRET="generate-me-do-not-reuse-across-environments"

# Master key that wraps every user's provider API key (AES-256-GCM).
# Rotating this requires re-wrapping stored keys — see docs/adr/0007.
#   openssl rand -base64 32
KEY_ENCRYPTION_KEY="generate-me-32-bytes-base64"

# Transactional email (verification, password reset). Optional in dev:
# leave empty and mail is written to the local mailpit container instead.
RESEND_API_KEY=""
